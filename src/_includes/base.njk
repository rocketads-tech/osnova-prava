<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/img/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Юридические услуги с гарантией результата — {{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/img/og-image.png">
  <link rel="stylesheet" href="/css/style.css?v=20261104-6">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#A3885F">

  <!-- Локальный Swiper CSS -->
<link rel="stylesheet" href="/css/vendor/swiper-bundle.min.css">

	<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Oranienbaum&display=swap" rel="stylesheet">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": "{{ site.name }}",
        "description": "{{ site.description }}",
        "inLanguage": "ru-RU",
        "publisher": { "@id": "{{ site.url }}/#org" }
      },
      {
        "@type": ["LegalService", "LocalBusiness"],
        "@id": "{{ site.url }}/#org",
        "name": "{{ contacts.legalName }}",
        "legalName": "{{ contacts.legalName }}",
        "url": "{{ site.url }}/",
        "telephone": "{{ contacts.phone | replace('8-', '+7') | replace('-', '') }}",
        "email": "{{ contacts.email }}",
        "image": "{{ site.url }}/img/hero.png",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ site.url }}/img/logo.png",
          "width": 624,
          "height": 624
        },
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "{{ contacts.addressParts.country }}",
          "addressLocality": "{{ contacts.addressParts.locality }}",
          "streetAddress": "{{ contacts.addressParts.street }}"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "17:00"
        },
        "areaServed": [
          {%- for office in offices.items %}
          {
            "@type": "City",
            "name": "{{ office.city }}"
          }{{ "," if not loop.last else "" }}
          {%- endfor %}
        ],
        "sameAs": [
          "https://t.me/{{ contacts.socials.telegram | replace('@', '') }}",
          "https://wa.me/{{ contacts.socials.whatsapp | replace('+', '') }}",
          "{{ contacts.socials.vk }}"
        ]
      }{% if home %},
      {
        "@type": "ItemList",
        "name": "{{ services.title }}",
        "itemListElement": [
          {%- for service in services.items %}
          {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "item": {
              "@type": "Service",
              "name": "{{ service.title }}"
            }
          }{{ "," if not loop.last else "" }}
          {%- endfor %}
        ]
      }{% endif %}{% if not home %},
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Главная",
            "item": "{{ site.url }}/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "{{ title }}",
            "item": "{{ site.url }}{{ page.url }}"
          }
        ]
      }{% endif %}
    ]
  }
  </script>
</head>
<body>
  {% include "header.njk" %}
  <main{% if home %} style="min-height: 300vh"{% endif %}>
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  
  {% include "blocks/modal.njk" %}
  
  <!-- Локальный Swiper JS -->
  <script src="/js/vendor/swiper-bundle.min.js"></script>

  <script src="/js/main.js?v=20261104-6" defer></script>
</body>
</html>