<div id="callback-modal" class="modal" data-form-type="consultation" data-modal-title="Бесплатная консультация юриста" data-modal-subtitle="Юрист проконсультирует вас в телефонном режиме">
  <div class="modal-content">
    <button class="modal-close" type="button" aria-label="Закрыть">&times;</button>
    <h3 class="modal-title" data-modal-title>Бесплатная консультация юриста</h3>
    <p class="modal-subtitle" data-modal-subtitle>Юрист проконсультирует вас в телефонном режиме</p>
