<header class="header">
  <div class="container header-container">
    <div class="header-top">
      <div class="logo">
        <img src="/img/logo-2.png" alt="{{ site.name }}">
        <span>{{ site.name }}</span>
      </div>
      <div class="header-contacts">
        <div class="socials">
          <a href="https://wa.me/{{ contacts.socials.whatsapp }}" aria-label="WhatsApp">
            <img src="/img/icon-whatsapp.svg" alt="WhatsApp">
          </a>
          <a href="https://t.me/{{ contacts.socials.telegram }}" aria-label="Telegram">
            <img src="/img/icon-telegram.svg" alt="Telegram">
          </a>
        </div>
        <a href="tel:{{ contacts.phone }}" class="phone">{{ contacts.phone }}</a>
        
        <!-- Кнопка бургера теперь внутри header-contacts -->
        <button class="burger" id="burger-btn" aria-label="Меню">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
    
    <nav class="header-nav">
      <div class="header-nav-inner">
        <ul>
          <li><a href="#hero">Главная</a></li>
          <li><a href="#services">Услуги</a></li>
          <li><a href="#about">О юристе</a></li>
          <li><a href="#advantages">Гарантии</a></li>
          {% if reviewsVisible.hasVisible %}
          <li><a href="#reviews">Отзывы</a></li>
          {% endif %}
          <li><a href="#contacts">Контакты</a></li>
        </ul>
      </div>
    </nav>
  </div>
  
  <!-- Мобильное меню -->
  <nav class="mobile-nav" id="mobile-nav">
    <ul>
      <li><a href="#hero" class="mobile-link">Главная</a></li>
      <li><a href="#services" class="mobile-link">Услуги</a></li>
      <li><a href="#about" class="mobile-link">О юристе</a></li>
      <li><a href="#advantages" class="mobile-link">Гарантии</a></li>
      {% if reviewsVisible.hasVisible %}
      <li><a href="#reviews" class="mobile-link">Отзывы</a></li>
      {% endif %}
      <li><a href="#contacts" class="mobile-link">Контакты</a></li>
    </ul>
  </nav>
</header>